###

POST {{baseUrl}}/precedent/match
Content-Type: application/json

{
  "analysisTargets": [
    {
      "targetText": "야 너 게이지 맞지?",
      "legalContext": {
        "isGroupChat": true,
        "audienceCount": 8,
        "victimIdentifiable": true
      }
    }
  ]
}

###

POST {{baseUrl}}/precedent/search
Content-Type: application/json

{
  "query": "단톡방에서 친구를 모욕한 경우 공연성과 증거 인정 기준",
  "mode": "hybrid",
  "limit": 10,
  "offset": 0,
  "filters": {}
}

###

POST {{baseUrl}}/precedent/search
Content-Type: application/json

{
  "query": "2007노120",
  "mode": "summary",
  "limit": 5,
  "offset": 0,
  "filters": {
